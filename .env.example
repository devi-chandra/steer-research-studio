# Steer Research-to-Content Studio Environment Configuration

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths (relative to backend or absolute)
STORAGE_DIR=../storage
DATABASE_URL=sqlite:///../storage/steer_studio.db

# AI Provider Configuration: "gemini", "openai", or "local_sample"
# If no API key is provided, the system gracefully operates in "local_sample" mode
AI_PROVIDER=local_sample

# Google Gemini API Key (Optional - enables real LLM inference)
GEMINI_API_KEY=

# OpenAI API Key (Optional - alternative LLM provider)
OPENAI_API_KEY=

# Text-To-Speech Configuration: "edge-tts" (recommended, high quality neural) or "pyttsx3" (offline system voice)
TTS_ENGINE=edge-tts
TTS_VOICE=en-IN-NeerjaNeural

# Video Rendering Settings
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FFMPEG_PATH=ffmpeg
