# Steer AI-Powered Research-to-Content Studio Environment Configuration

# Server
PORT=8005
HOST=127.0.0.1
DEBUG=true

# AI Provider Credentials (Optional - deterministic scientific engine fallback is used if not provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=deterministic  # Options: auto, gemini, openai, deterministic

# Storage Directories (Relative to project root or absolute paths)
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
GENERATED_DIR=storage/generated
EXPORTS_DIR=storage/exports
DATABASE_PATH=storage/steer_studio.db

# Narration / TTS Configuration
TTS_PROVIDER=edge-tts      # Options: edge-tts, gtts, pyttsx3
